{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:http-intake.logs.us5.datadoghq.com)",
      "Bash(claude mcp *)"
    ]
  },
  "enabledMcpjsonServers": ["google-calendar", "mcp-atlassian"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-md-check.py\""
          }
        ]
      }
    ]
  }
}
